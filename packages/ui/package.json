{
  "name": "@agent-watch/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "clsx": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@agent-watch/config": "workspace:*",
    "@types/react": "latest",
    "eslint": "latest",
    "typescript": "latest"
  },
  "peerDependencies": {
    "react": "*"
  }
}
